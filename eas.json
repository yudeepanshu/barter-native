{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NPM_CONFIG_INSTALL_STRATEGY": "hoisted",
        "NPM_CONFIG_WORKSPACES": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NPM_CONFIG_INSTALL_STRATEGY": "hoisted",
        "NPM_CONFIG_WORKSPACES": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NPM_CONFIG_INSTALL_STRATEGY": "hoisted",
        "NPM_CONFIG_WORKSPACES": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}