{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "android:standalone": "npm run apk:standalone && adb install -r android\\app\\build\\outputs\\apk\\debug\\app-debug.apk && adb shell am start -n com.barter.app/.MainActivity",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:standalone": "cd android && gradlew.bat assembleDebug -PembedDebugBundle=true",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@barter/api-client": "*",
    "@barter/types": "*",
    "@tanstack/react-query": "^5.95.2",
    "expo": "~55.0.9",
    "expo-constants": "^55.0.9",
    "expo-file-system": "~55.0.12",
    "expo-image-picker": "~55.0.14",
    "expo-linking": "~55.0.9",
    "expo-location": "~55.1.4",
    "expo-notifications": "~55.0.14",
    "expo-router": "~55.0.8",
    "expo-secure-store": "^55.0.9",
    "expo-splash-screen": "~55.0.13",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint-config-expo": "^55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
